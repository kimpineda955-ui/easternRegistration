@startuml
skinparam classAttributeIconSize 0
hide circle

class EasternSchedule {
  -{static} BASE: String = "https://reg-prod.ec.easternct.edu/StudentRegistrationSsb"
  -term: String
  ~cookieManager: CookieManager
  ~client: HttpClient
  --
  +EasternSchedule()
  +getTerm(): String
  -retrieveTerms(): String
  -parseTerms(content: String): ArrayList<Term>
  -parseCourses(content: String): ArrayList<Course>
  +getAvailableTerms(): ArrayList<Term>
  -postTerm(): String
  -createCacheFile(subject: String): Path
  -cacheCourses(subject: String): void
  +queryCourseBySubject(subject: String): ArrayList<Course>
}

record Course {
  -id : String
  -subject: String
  -courseNumber: String
  -meetingsFaculty: List<MeetingFaculty>
}

record MeetingFaculty {
  -meetingTime: MeetingTime
}

record MeetingTime {
  -monday: boolean
  -tuesday: boolean
  -wednesday: boolean
  -thursday: boolean
  -friday: boolean
  -saturday: boolean
  -sunday: boolean
}

record Term {
  -code: String
  -description: String
}

'Aggregation and composition
MeetingFaculty "1" o-- "1" MeetingTime : has a >
Course "1" 0-- "0*" MeetingFaculty: has a >

'Dependencies
EasternSchedule ..> Term : uses
EasternSchedule ..> Course : uses

class Student {
  +{static} MAX_CREDITS: int = 17
  -id: String
  -firstName: String
  -lastName: String
  -courses: List<Course>
  --
  +Student()
  +Student(id: String, firstName: String, lastName: String)
  +getId(): String
  +setId(id: String): void
  +getFirstName(): String
  +setFirstName(firstName: String): void
  +getLastName(): String
  +setLastName(lastName: String): void
  +getCourses(): List<Course>
  +setCourses(courses: List<Course>): void
  +getTotalCredits(): int
  +addCourse(course: Course): String
  +dropCourse(referenceNumber: String): boolean
  +dropAllCourses(): void
}

class MainMenu {
  -easternSchedule: EasternSchedule
  -scanner: Scanner
  -student: Student
  --
  +MainMenu()
  +open(): void
  -displayMenu(): void
  -displayCoursesBySubject(): void
  -searchCourses(): void
  -hasMeetingDay(course: Course, day: String): boolean
  -createStudent(): void
  -addCourse(): void
  -dropCourse(): void
  -displayStudentSchedule(): void
  -requireStudent(): boolean
}

MainMenu --> EasternSchedule : retrieves courses
MainMenu --> Student : manages registration
Student "1" o-- "0..*" Course : registers for

@enduml